# TokenPulse Environment Configuration (.env.example)

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Administrative Security Key (Used to authorize pricing/budget edits and resets)
ADMIN_API_KEY=tokenpulse-admin-key-2026

# Proxy API Access Control (Optional comma-separated list of keys; set PROXY_AUTH_REQUIRED=true to enforce)
PROXY_AUTH_REQUIRED=false
PROXY_API_KEYS=tp-live-key-public,demo-proxy-key

# Upstream Real AI Provider Credentials (Leave empty to use built-in offline simulation mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=

ANTHROPIC_API_KEY=

# Supabase Auth & PostgreSQL Configuration (Enterprise Identity & Telemetry)
# You can use standard names or VITE_ prefixed conventions:
SUPABASE_URL=https://nfdjgtgkzxujkdjtknmn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_NudHRspz_uT0THLpuNj34w_L3YiqKc8
# Alternative VITE_ variable names:
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional service role key for administrative backend tasks (NEVER exposed to frontend)
SUPABASE_SERVICE_ROLE_KEY=
